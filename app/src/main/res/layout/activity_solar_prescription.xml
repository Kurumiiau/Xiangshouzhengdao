<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:fitsSystemWindows="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
        <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:baselineAligned="false" android:contentDescription="@string/cd_back">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/solar_pres_title" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" android:includeFontPadding="false" app:drawableStartCompat="@drawable/ic_back" app:drawableTint="@color/text_primary" android:drawablePadding="14dp" android:gravity="center_vertical" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_hero">
            <ImageView android:layout_width="170dp" android:layout_height="170dp" android:layout_gravity="end|bottom" android:src="@drawable/bg_hero_glow" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/solar_current" android:textColor="@color/text_white" android:textSize="12sp" android:alpha="0.8" android:includeFontPadding="false" />
                <TextView android:id="@+id/tvCurrentSolarTerm" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="小暑" android:textColor="@color/text_white" android:textSize="34sp" android:textStyle="bold" android:layout_marginTop="6dp" android:includeFontPadding="false" />
                <TextView android:id="@+id/tvCurrentTheme" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="夏清心" android:textColor="@color/text_white" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_hero_chip" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginTop="12dp" android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_glass" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/solar_recommend" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/tvCurrentEffect" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" tools:text="清心解暑、安神定志" android:textColor="@color/text_secondary" android:textSize="13.5sp" android:lineSpacingMultiplier="1.35" android:includeFontPadding="false" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/solar_jun" android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false" />
            <LinearLayout android:id="@+id/junHerbsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:baselineAligned="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_glass" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/solar_all" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerSolarTerms" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="60dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>