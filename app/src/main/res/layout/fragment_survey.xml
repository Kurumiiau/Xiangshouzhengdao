<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="130dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_title" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="10dp" android:includeFontPadding="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_subtitle" android:textSize="13sp" android:textColor="@color/text_hint" android:layout_marginTop="4dp" android:layout_marginBottom="20dp" android:includeFontPadding="false" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuickSurvey" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/glass_white" app:strokeColor="@color/glass_stroke" app:strokeWidth="1dp" android:clickable="true" android:focusable="true" android:foreground="@drawable/ripple_soft">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:baselineAligned="false">
                <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_icon_tile" android:backgroundTint="@color/tile_red_bg">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:src="@drawable/ic_test" android:contentDescription="@string/survey_quick_title" android:importantForAccessibility="no" app:tint="@color/tile_red_fg" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_quick_title" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:includeFontPadding="false" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_quick_desc" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="5dp" android:includeFontPadding="false" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_quick_chip" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/tile_red_fg" android:background="@drawable/bg_tag" android:backgroundTint="@color/tile_red_bg" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:includeFontPadding="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardFullSurvey" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/glass_white" app:strokeColor="@color/glass_stroke" app:strokeWidth="1dp" android:clickable="true" android:focusable="true" android:foreground="@drawable/ripple_soft">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:baselineAligned="false">
                <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/bg_icon_tile" android:backgroundTint="@color/tile_green_bg">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:src="@drawable/ic_assessment" android:contentDescription="@string/survey_full_title" android:importantForAccessibility="no" app:tint="@color/tile_green_fg" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_full_title" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary" android:includeFontPadding="false" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_full_desc" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="5dp" android:includeFontPadding="false" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_full_chip" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/tile_green_fg" android:background="@drawable/bg_tag" android:backgroundTint="@color/tile_green_bg" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:includeFontPadding="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/survey_disclaimer" android:textSize="12sp" android:textColor="@color/text_hint" android:gravity="center" android:lineSpacingMultiplier="1.4" android:layout_marginTop="28dp" android:includeFontPadding="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>