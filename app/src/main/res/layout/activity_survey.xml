<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressDrawable="@drawable/progress_horizontal" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/tvQuestionNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/survey_question_no" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" app:layout_constraintTop_toBottomOf="@id/progressBar" app:layout_constraintStart_toStartOf="parent" android:layout_marginStart="20dp" android:layout_marginTop="18dp" android:includeFontPadding="false" />
    <TextView android:id="@+id/tvBodyTypeBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="平和质" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_white" android:background="@drawable/bg_body_type_badge" android:paddingHorizontal="12dp" android:paddingVertical="5dp" app:layout_constraintTop_toTopOf="@id/tvQuestionNumber" app:layout_constraintBottom_toBottomOf="@id/tvQuestionNumber" app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="20dp" android:includeFontPadding="false" />
    <androidx.cardview.widget.CardView android:id="@+id/cardQuestion" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bg_card" app:layout_constraintTop_toBottomOf="@id/tvQuestionNumber" app:layout_constraintBottom_toTopOf="@id/bottomNav" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginTop="18dp" android:layout_marginBottom="18dp">
        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <TextView android:id="@+id/tvQuestionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/result_verdict" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" android:lineSpacingMultiplier="1.45" android:includeFontPadding="false" />
                <LinearLayout android:id="@+id/optionsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="22dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnOptionA" style="@style/OptionButton" android:text="@string/opt_1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnOptionB" style="@style/OptionButton" android:text="@string/opt_2" android:layout_marginTop="10dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnOptionC" style="@style/OptionButton" android:text="@string/opt_3" android:layout_marginTop="10dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnOptionD" style="@style/OptionButton" android:text="@string/opt_4" android:layout_marginTop="10dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnOptionE" style="@style/OptionButton" android:text="@string/opt_5" android:layout_marginTop="10dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="14dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:baselineAligned="false">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPrev" style="@style/NavButton" android:text="@string/survey_prev" android:textColor="@color/primary" app:backgroundTint="@color/selected" app:cornerRadius="14dp" />
        <View android:layout_width="12dp" android:layout_height="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmit" style="@style/NavButton" android:text="@string/survey_submit" android:textColor="@color/text_white" app:backgroundTint="@color/primary" app:cornerRadius="14dp" android:enabled="true" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>