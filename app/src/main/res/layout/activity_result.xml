<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_title" android:textSize="23sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:includeFontPadding="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_subtitle" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:includeFontPadding="false" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="300dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bg_card" android:layout_marginBottom="14dp">
            <com.github.mikephil.charting.charts.RadarChart android:id="@+id/radarChart" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" />
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bg_card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_verdict" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" android:includeFontPadding="false" />
                <TextView android:id="@+id/tvResultTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_verdict" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="8dp" android:includeFontPadding="false" android:fontFamily="serif" />
                <TextView android:id="@+id/tvResultDesc" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="您核心体质为气郁质,存在焦虑压抑、入睡困难、胸闷叹气类身体困扰。" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.4" android:includeFontPadding="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bg_card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_troubles" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" android:includeFontPadding="false" />
                <TextView android:id="@+id/tvTroubles" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="焦虑压抑、入睡困难、胸闷叹气" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.4" android:includeFontPadding="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bg_card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_formula_label" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" android:includeFontPadding="false" />
                        <TextView android:id="@+id/tvPrescriptionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_formula_name" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:includeFontPadding="false" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnFavorite" android:layout_width="wrap_content" android:layout_height="38dp" android:text="@string/result_favorite" android:textSize="14sp" android:textColor="@color/text_hint" style="@style/Widget.Material3.Button.TextButton" android:minWidth="0dp" android:paddingHorizontal="12dp" />
                </LinearLayout>
                <TextView android:id="@+id/tvContraindications" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/accent" android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.3" android:visibility="gone" android:includeFontPadding="false" />
                <TextView android:id="@+id/tvTotalEffect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="10dp" android:visibility="gone" android:includeFontPadding="false" />
                <LinearLayout android:id="@+id/herbListContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bg_card" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_recommend" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:includeFontPadding="false" />
                <LinearLayout android:id="@+id/productsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp" android:baselineAligned="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnShare" android:layout_width="match_parent" android:layout_height="54dp" android:text="@string/result_save_image" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_white" app:cornerRadius="16dp" app:backgroundTint="@color/primary" app:icon="@drawable/ic_download" app:iconTint="@color/text_white" app:iconGravity="textStart" app:iconSize="20dp" android:elevation="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRetest" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="@string/result_retest" android:textSize="14sp" android:textColor="@color/text_hint" style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/result_disclaimer" android:textSize="12sp" android:textColor="@color/text_hint" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:includeFontPadding="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>