<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/bg_main" app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/text_primary" app:titleTextColor="@color/text_primary">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/herb_list_title" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_gravity="center" android:includeFontPadding="false" />
    </androidx.appcompat.widget.Toolbar>
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="46dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_glass" android:paddingStart="14dp" android:paddingEnd="8dp" android:baselineAligned="false" android:id="@+id/searchContainer" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/btnCategory" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@drawable/ic_search" android:contentDescription="@string/cd_search" android:importantForAccessibility="no" app:tint="@color/text_hint" />
            <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:hint="@string/herb_search_hint" android:textSize="14sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:paddingStart="10dp" android:paddingEnd="10dp" android:imeOptions="actionSearch" android:inputType="text" android:importantForAutofill="no" />
            <ImageView android:id="@+id/btnClearSearch" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_close" android:contentDescription="@string/cd_clear" android:importantForAccessibility="no" android:visibility="gone" app:tint="@color/text_hint" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnCategory" android:layout_width="wrap_content" android:layout_height="46dp" android:layout_marginStart="12dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_glass" android:backgroundTint="@color/primary" android:paddingStart="16dp" android:paddingEnd="16dp" android:clickable="true" android:focusable="true" android:baselineAligned="false" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
            <TextView android:id="@+id/tvCategoryLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/herb_category" android:textColor="@color/text_white" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView android:id="@+id/tvCurrentCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginBottom="6dp" android:text="@string/herb_all" android:textSize="13sp" android:textColor="@color/text_secondary" android:background="@drawable/bg_tag" android:backgroundTint="@color/tile_green_bg" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone" android:includeFontPadding="false" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerHerbs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="8dp" android:paddingEnd="8dp" android:clipToPadding="false" />
    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/herb_empty" android:textColor="@color/text_hint" android:textSize="15sp" android:gravity="center" android:drawablePadding="16dp" app:drawableTopCompat="@drawable/ic_empty_herb" app:drawableTint="@color/text_hint" android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>