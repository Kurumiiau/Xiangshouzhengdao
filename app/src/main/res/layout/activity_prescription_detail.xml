<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/bg_main" app:navigationIcon="@drawable/ic_back" app:navigationIconTint="@color/text_primary" app:titleTextColor="@color/text_primary">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rxdetail_title" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_gravity="center" android:includeFontPadding="false" />
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="气郁体质" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_gravity="center_horizontal" android:includeFontPadding="false" />
            <TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="小暑 · 专属香方" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" android:includeFontPadding="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_glass" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rxdetail_effect" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" android:includeFontPadding="false" />
                <TextView android:id="@+id/tvTotalEffect" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="疏肝解郁、理气安神" android:textSize="14.5sp" android:textColor="@color/text_primary" android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.4" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_glass" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rxdetail_composition" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" android:includeFontPadding="false" />
                <LinearLayout android:id="@+id/herbListContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_glass" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rxdetail_products" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" android:includeFontPadding="false" />
                <LinearLayout android:id="@+id/productsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:baselineAligned="false" />
            </LinearLayout>
            <TextView android:id="@+id/tvContraindications" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/accent" android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.3" android:visibility="gone" android:includeFontPadding="false" />
            <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="收藏时间:2026-07-14" android:textSize="12sp" android:textColor="@color/text_hint" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:includeFontPadding="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteFavorite" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:text="@string/rxdetail_unsave" android:textSize="15sp" android:textColor="@color/accent" style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>