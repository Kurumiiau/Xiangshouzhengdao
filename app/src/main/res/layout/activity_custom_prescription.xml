<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:clickable="true" android:focusable="true" android:baselineAligned="false" android:contentDescription="@string/cd_back">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/custom_title" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" android:includeFontPadding="false" app:drawableStartCompat="@drawable/ic_back" app:drawableTint="@color/text_primary" android:drawablePadding="14dp" android:gravity="center_vertical" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_glass" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/custom_body" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginBottom="10dp" android:includeFontPadding="false" />
                <Spinner android:id="@+id/spinnerBodyType" android:layout_width="match_parent" android:layout_height="52dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/bg_glass" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_glass" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/custom_scene" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginBottom="10dp" android:includeFontPadding="false" />
                <Spinner android:id="@+id/spinnerScene" android:layout_width="match_parent" android:layout_height="52dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/bg_glass" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnGenerate" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="20dp" android:text="@string/custom_generate" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_white" app:backgroundTint="@color/primary" app:cornerRadius="16dp" android:elevation="0dp" />
            <androidx.cardview.widget.CardView android:id="@+id/cardResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/glass_white" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/custom_result_title" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/primary" android:layout_marginBottom="10dp" android:includeFontPadding="false" />
                    <TextView android:id="@+id/tvPrescriptionResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/text_primary" android:lineSpacingMultiplier="1.5" android:includeFontPadding="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>