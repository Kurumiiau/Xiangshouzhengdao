<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:orientation="vertical" android:background="@drawable/bg_glass" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <TextView android:id="@+id/tvTermName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" android:includeFontPadding="false" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/tvTermDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12.5sp" android:textColor="@color/primary" android:background="@drawable/bg_tag" android:backgroundTint="@color/tile_teal_bg" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/tvThreePeriods" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12.5sp" android:textColor="@color/text_secondary" android:layout_marginTop="6dp" android:includeFontPadding="false" />
    <TextView android:id="@+id/tvDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12.5sp" android:textColor="@color/text_hint" android:layout_marginTop="3dp" android:includeFontPadding="false" />
</LinearLayout>