<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="9dp" android:paddingBottom="9dp" android:baselineAligned="false">
    <TextView android:id="@+id/tvHerbRole" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" tools:text="君" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_icon_tile" android:backgroundTint="@color/bg_warm" android:includeFontPadding="false" />
    <TextView android:id="@+id/tvHerbName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" tools:text="佛手" android:textSize="15sp" android:textColor="@color/text_primary" android:includeFontPadding="false" />
    <TextView android:id="@+id/tvHerbRatio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" android:includeFontPadding="false" tools:text="20%" />
</LinearLayout>