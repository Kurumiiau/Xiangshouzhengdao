<?xml version="1.0" encoding="utf-8"?>
<!-- 启动屏单独用完整原图，不复用会被系统再次缩放、裁切的自适应桌面图标。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="104.00dp" android:height="104.00dp" android:gravity="center">
        <bitmap android:src="@drawable/logo" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
